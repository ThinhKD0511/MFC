#include "resource.h"
#include <afxres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_MFCFILEWEEK1_DIALOG DIALOGEX 0, 0, 420, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hello World MFC - Tuan 1"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Noi dung:", IDC_STATIC, 12, 12, 100, 12
    EDITTEXT        IDC_EDIT_CONTENT, 12, 28, 396, 126, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Duong dan luu file:", IDC_STATIC, 12, 164, 120, 12
    EDITTEXT        IDC_EDIT_PATH, 12, 180, 290, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON      "Chon folder...", IDC_BTN_FOLDER, 310, 178, 98, 18
    PUSHBUTTON      "Save", IDC_BTN_SAVE, 248, 208, 76, 22
    PUSHBUTTON      "Load", IDC_BTN_LOAD, 332, 208, 76, 22
END

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_MFCFILEWEEK1_DIALOG, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 413
        TOPMARGIN, 7
        BOTTOMMARGIN, 231
    END
END
#endif
