// Resource script with Visual Studio Resource Includes metadata.
#include "resource.h"
#define APSTUDIO_READONLY_SYMBOLS
#include <afxres.h>
#include <commctrl.rh>
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include <afxres.h>\r\n"
    "#include <commctrl.rh>\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif

IDD_CHAT DIALOGEX 0, 0, 650, 365
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "MFC Chat"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "MFC Chat", -1, 12, 12, 295, 14
    LTEXT "Logged in:", IDC_STATIC_ACCOUNT, 335, 14, 220, 12
    PUSHBUTTON "Logout", IDC_BTN_ACCOUNT, 565, 9, 73, 22
    LTEXT "CONTACTS", -1, 12, 43, 160, 12
    CONTROL "", IDC_TREE_CONTACTS, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 12, 59, 148, 270
    LTEXT "Chat: MFC Team", IDC_STATIC_CURRENT_CHAT, 174, 43, 240, 12
    LTEXT "View:", -1, 460, 43, 28, 12
    COMBOBOX IDC_COMBO_VIEW, 491, 39, 147, 85, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_LIST_CHAT, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 174, 59, 464, 229
    LTEXT "Message:", -1, 174, 295, 300, 12
    EDITTEXT IDC_EDIT_MESSAGE, 174, 310, 382, 20, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Send", IDC_BTN_SEND, 565, 309, 73, 22
    LTEXT "Ready", IDC_STATIC_STATUS, 12, 343, 626, 12
END

IDD_LOGIN DIALOGEX 0, 0, 290, 173
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Login"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Log in to MFC Chat", -1, 14, 12, 260, 14
    LTEXT "Username", -1, 14, 42, 63, 12
    EDITTEXT IDC_EDIT_USERNAME, 82, 38, 193, 20, ES_AUTOHSCROLL
    LTEXT "Password", -1, 14, 70, 63, 12
    EDITTEXT IDC_EDIT_PASSWORD, 82, 66, 193, 20, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Demo: admin / 123", -1, 82, 93, 190, 12
    DEFPUSHBUTTON "Login", IDOK, 82, 114, 92, 22
    PUSHBUTTON "Cancel", IDCANCEL, 183, 114, 92, 22
    PUSHBUTTON "No account? Register...", IDC_BTN_OPEN_REGISTER, 82, 142, 193, 20
END

IDD_REGISTER DIALOGEX 0, 0, 310, 185
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Register"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Create your account", -1, 14, 12, 285, 14
    LTEXT "Username", -1, 14, 44, 86, 12
    EDITTEXT IDC_EDIT_USERNAME, 103, 40, 192, 20, ES_AUTOHSCROLL
    LTEXT "Password", -1, 14, 74, 86, 12
    EDITTEXT IDC_EDIT_PASSWORD, 103, 70, 192, 20, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Confirm password", -1, 14, 104, 86, 12
    EDITTEXT IDC_EDIT_CONFIRM, 103, 100, 192, 20, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Username: 3-32 letters, numbers or underscore.", -1, 14, 130, 285, 12
    DEFPUSHBUTTON "Register", IDOK, 103, 151, 92, 22
    PUSHBUTTON "Cancel", IDCANCEL, 203, 151, 92, 22
END

